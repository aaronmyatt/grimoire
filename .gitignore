.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# smevals writes Run records here; eval-scoped grimoire libraries are throwaway.
# runs-* covers archived eras (e.g. runs-era1-confounded, parked when the
# 2026-08-12 harness fixes reset the baseline) — same throwaway data, and the
# formatters/linters must never descend into agent-written run artifacts.
evals/**/runs/
evals/**/runs-*/
evals/**/*.db
evals/**/*.db-wal
evals/**/*.db-shm

# swebench repo mirrors are a pure local cache (evals/grim-swebench/run-grim)
evals/**/cache/

# sweep arm label configs are generated on demand by evals/sweep-langs
evals/**/configs/L-*.yaml

# the swebench harness dumps build/eval logs into cwd (logs/build_images,
# logs/run_evaluation) — throwaway per-run droppings, same as evals/**/runs/
logs/
