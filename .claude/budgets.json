{
  "projectName": "grimoire",
  "stack": "python",
  "budgets": {
    "functionLines": 60,
    "fileLines": 500,
    "diffLines": 300,
    "maxParams": 4,
    "maxDepth": 4,
    "cyclomaticComplexity": 10,
    "lineWidth": 100,
    "assertionsMin": 2,
    "payloadKB": 140,
    "criticalPathKB": 42,
    "latencyMs": 100,
    "coveragePercent": 0
  },
  "slices": {
    "root": "src/grim",
    "shared": "src/grim",
    "slices": ["verbs", "exec", "adapter", "seeds"],
    "sharedFiles": ["src/grim/db.py", "src/grim/cli.py"],
    "frozenPaths": [
      "src/grim/db.py",
      "src/grim/cli.py",
      ".claude/**",
      "CLAUDE.md",
      "pyproject.toml",
      "uv.lock",
      ".github/workflows/**"
    ]
  },
  "commands": {},
  "baselinePaths": []
}
