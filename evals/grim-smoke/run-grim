#!/usr/bin/env bash
# smevals Runner for the grim-agent harness. Contract: all inputs arrive as
# environment variables, the model's final answer goes to stdout, and a
# non-zero exit marks the Run failed (reserve that for infra faults only).
# Ref: https://github.com/prime-radiant-inc/smevals  (`smevals docs`)
#
# DB isolation is both this experiment's core variable AND a hard safety rule:
# GRIM_DB is ALWAYS set explicitly, so an eval never reads or writes the
# operator's real ~/.grimoire library. Precedence:
#   1. SMEVALS_TASK_GRIM_DB  per-task path   → group tasks (e.g. one DB per repo)
#   2. GRIM_EVAL_DB          operator export → WARM: one shared DB accumulates
#                            across tasks — the compounding condition
#   3. (neither set)         COLD: a fresh DB under the Run dir — the control
set -uo pipefail

: "${SMEVALS_MODEL:?run-grim: SMEVALS_MODEL is required}"
: "${SMEVALS_PROMPT:?run-grim: SMEVALS_PROMPT is required (the task needs a prompt)}"
: "${SMEVALS_RUN_DIR:?run-grim: SMEVALS_RUN_DIR is required}"

export GRIM_DB="${SMEVALS_TASK_GRIM_DB:-${GRIM_EVAL_DB:-$SMEVALS_RUN_DIR/grimoire.db}}"
export GRIM_TRAJ_DIR="$SMEVALS_RUN_DIR"   # keep the trajectory JSON as a Run artifact
# Language availability is pinned for the same isolation reason as GRIM_DB:
# without this, the languages the agent may write leak from the operator's
# ~/.grimoire config. Task key `grim_languages:` wins; the default baseline
# is python+bash (both are always in the schema regardless).
# Sweep arm knob: GRIM_EVAL_LANGUAGES widens the set per batch (task key
# still wins) — same operator-override slot GRIM_EVAL_DB occupies.
export GRIM_LANGUAGES="${SMEVALS_TASK_GRIM_LANGUAGES:-${GRIM_EVAL_LANGUAGES:-python,bash}}"
# Its pair: GRIM_EVAL_BASE_LANGUAGES SUBSETS the python/bash builtins the
# agent may write ('' removes them — solo-language arms). `-` not `:-`:
# empty string is meaningful here and must survive the chain.
export GRIM_BASE_LANGUAGES="${SMEVALS_TASK_GRIM_BASE_LANGUAGES-${GRIM_EVAL_BASE_LANGUAGES-python,bash}}"

# db-mode label for the run-identity artifact below (mirrors grim-debug).
if [ -n "${SMEVALS_TASK_GRIM_DB:-}" ]; then DB_MODE="grouped"
elif [ -n "${GRIM_EVAL_DB:-}" ]; then DB_MODE="warm"
else DB_MODE="cold"; fi

# Run identity: a runner-chosen session id (handed to GrimEnvironment via
# mini's -c merge — the same seam `--continue` uses) plus a grim-run.json
# artifact, so the run-metrics Grader can scope DB queries to exactly this
# Run's rows in a shared (warm/grouped) library, long after these env vars
# are gone. Values are slugs/paths that never contain quotes — safe to
# inline as JSON without an escaping pass.
GRIM_SESSION_ID="smevals-${SMEVALS_TASK}-$(date +%Y%m%dT%H%M%S)-$$"
printf '{"session_id": "%s", "db": "%s", "db_mode": "%s", "languages": "%s", "base_languages": "%s"}\n' \
  "$GRIM_SESSION_ID" "$GRIM_DB" "$DB_MODE" "$GRIM_LANGUAGES" "$GRIM_BASE_LANGUAGES" \
  > "$SMEVALS_RUN_DIR/grim-run.json"

# grim-agent prints its final answer to stdout and its banner/log to stderr
# (src/grim/adapter/launcher.py), so capturing stdout yields the clean answer.
# Override the launch command via GRIM_AGENT_CMD when grim isn't on PATH, e.g.
#   export GRIM_AGENT_CMD="uv run --project /path/to/grimoire grim-agent"
# Left unquoted on purpose so a multi-word command word-splits; this is a
# launcher, not grim's control plane (so the no-shell invariant does not apply).
#
# `-p` (print mode) is load-bearing, not optional. It does two things a batch
# run needs: (1) emits ONLY the agent's final answer on stdout — mini's whole
# UI transcript goes to stderr (captured as the Run's stderr.txt) — so
# output.txt is the answer the Grader checks, not KBs of transcript; and (2)
# runs unattended (it implies --exit-immediately), so it never blocks on mini's
# post-`submit` follow-up prompt even though smevals leaves stdin a TTY.
# shellcheck disable=SC2086
out="$(${GRIM_AGENT_CMD:-grim-agent} -p -m "$SMEVALS_MODEL" -t "$SMEVALS_PROMPT" \
  -c "environment.session_id=$GRIM_SESSION_ID")"
ec=$?

printf '%s\n' "$out"

# smevals: exit non-zero ONLY for infrastructure failure; exit 0 for any real
# (even wrong) model response so the Grader decides pass/fail. exit 2 is grim's
# missing 'agent' extra (launcher.MISSING_EXTRA_EXIT_CODE); empty output means
# the harness produced no answer at all. Both are infra faults.
if [ "$ec" -eq 2 ] || [ -z "${out//[[:space:]]/}" ]; then
  echo "run-grim: grim-agent produced no answer (exit $ec) — infra failure" >&2
  exit 1
fi
exit 0
