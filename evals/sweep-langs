#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pyyaml>=6"]
# ///
"""Language-combination sweep: drive N arms across the screen evals, then
render one arm × eval comparison table from the grades.

An arm = one writable-language set, written as a plain comma list. The
driver derives BOTH knobs from it (arm_env): builtins named in the arm →
GRIM_EVAL_BASE_LANGUAGES (naming neither python nor bash removes them — a
solo arm like `jq` really is jq-only writing), everything else →
GRIM_EVAL_LANGUAGES. Mechanically each arm is a PAIR the driver keeps
zipped: a generated 2-line label config (configs/L-<slug>.yaml, same
../run-grim runner) that namespaces run dirs and smevals' native config ×
model leaderboard, plus those env exports that actually change the agent's
action space. Every run stamps both values into grim-run.json (see
run-grim), so arms are verifiable per run, never implied.

Always cold (GRIM_EVAL_COLD=1): the screen varies ONE thing — the language
set — with no cross-arm library contamination. `-n` is plain repetition
(the installed smevals has no run-count targeting): each rep re-invokes
`smevals run` for the arm, so re-running a finished sweep ADDS runs.
`--report-only` aggregates whatever already exists without running.

    evals/sweep-langs --preset screen -m deepseek/deepseek-v4-flash -n 1
    evals/sweep-langs --preset screen --report-only
    evals/sweep-langs --arms python,bash --arms python,bash,jq --evals grim-smoke

--combo/--combo-k generates every size-k combination of a slot list instead
of hand-typing arms: a slot may be a `+`-joined atomic unit (e.g. tcl+expect)
that always travels together, never splits across combinations.

    evals/sweep-langs --combo bun --combo lua --combo sql --combo awk \
      --combo tcl+expect --combo perl --combo-k 2   # all 15 pairs
      # --combo-k 2,3 adds the 20 triples on top; escalating later just adds
      # more arms into the same runs/ tree, nothing already graded reruns.

Runs are sequential on purpose; parallelize only after one clean serial
sweep proves there is no shared state. pyyaml rides PEP 723 + uv — no
project dependency. Ref: https://docs.astral.sh/uv/guides/scripts/
"""

from __future__ import annotations

import argparse
import itertools
import os
import pathlib
import re
import shutil
import subprocess
import sys
from typing import Any, NamedTuple

import yaml

EVALS_DIR = pathlib.Path(__file__).resolve().parent
SCREEN_EVALS = ("grim-smoke", "grim-debug", "grim-solve")
_BASE = "python,bash"
SCREEN_ARMS = (
    "python",  # is bash even needed?
    "bash",  # inverse control
    _BASE,  # baseline
    _BASE + ",jq",
    _BASE + ",bun",
    _BASE + ",sql",
    _BASE + ",awk",
    _BASE + ",ruby",
    _BASE + ",duckdb",
    _BASE + ",jq,bun,sql,awk,ruby,perl,php,go,bc,duckdb",  # the pool
)
BUILTIN_PAIR = frozenset({"python", "bash"})
# Solo-viable languages with runtimes installed on this host (docs/languages.md
# catalog ∩ `grim doctor`-ready; typst/osascript/dc excluded as task-irrelevant).
SOLO_LANGS = ("jq", "bun", "sql", "awk", "ruby", "perl", "php", "go", "lua", "duckdb", "bc")
# The overnight matrix: real controls + each language solo and with bash + the
# pool. Solo arms work because the arm string DERIVES both knobs (arm_env):
# builtins named in the arm form GRIM_EVAL_BASE_LANGUAGES, the rest form
# GRIM_EVAL_LANGUAGES — `jq` alone really is jq-only writing.
OVERNIGHT_ARMS = (
    "python",
    "bash",
    _BASE,
    *SOLO_LANGS,
    *(f"{lang},bash" for lang in SOLO_LANGS),
    _BASE + ",jq,bun,sql,awk,ruby,perl,php,go,bc,duckdb",
)
MAX_ARMS = 64  # headroom for a full k=2..6 combo sweep over a 6-slot family (57 arms)
MAX_EVALS = 5
N_MAX = 5  # repetitions cap — variance runs, not load tests
DEFAULT_MODEL = "deepseek/deepseek-v4-flash"
_ARM_RE = re.compile(r"^[a-z][a-z0-9_]*(,[a-z][a-z0-9_]*)*$")
METRICS_CHECKER_SUFFIX = "checkers/run-metrics"


class Options(NamedTuple):
    """One sweep invocation's knobs (bundled: 4-param budget, CLAUDE.md §1)."""

    arms: tuple[str, ...]
    evals: tuple[str, ...]
    model: str
    n: int
    dry_run: bool
    report_only: bool


class RunRow(NamedTuple):
    """One graded Run, flattened for aggregation."""

    arm: str
    model_dir: str
    eval_name: str
    passed: bool
    metrics: dict[str, Any]
    duration_s: float


def arm_slug(arm: str) -> str:
    """`python,bash,jq` -> `python+bash+jq` (config/dir-name safe)."""
    assert _ARM_RE.match(arm), f"malformed arm {arm!r} (want comma-joined language names)"
    slug = arm.replace(",", "+")
    assert "/" not in slug and " " not in slug, "slug must be path-safe"
    return slug


def arm_env(arm: str) -> dict[str, str]:
    """The env knobs one arm needs, derived from its plain language list:
    builtins named in the arm -> GRIM_EVAL_BASE_LANGUAGES (possibly '' —
    empty is meaningful, it removes python/bash from the writable set);
    everything else -> GRIM_EVAL_LANGUAGES. Always cold."""
    assert _ARM_RE.match(arm), "caller validates arms"
    tokens = [tok for tok in arm.split(",") if tok]
    base = [tok for tok in tokens if tok in BUILTIN_PAIR]
    extended = [tok for tok in tokens if tok not in BUILTIN_PAIR]
    assert len(base) + len(extended) == len(tokens), "every token lands in exactly one knob"
    return {
        "GRIM_EVAL_LANGUAGES": ",".join(extended),
        "GRIM_EVAL_BASE_LANGUAGES": ",".join(base),
        "GRIM_EVAL_COLD": "1",
    }


def combo_arms(slots: tuple[str, ...], ks: tuple[int, ...]) -> tuple[str, ...]:
    """Every size-k combination of `slots`, for each k in `ks`, flattened
    into plain arm strings. A slot may itself be a `+`-joined atomic unit
    (e.g. `tcl+expect`) that always travels together — a combination picks
    or skips the whole unit, never splits it. Tokens within a generated arm
    are sorted for a canonical string (stable regardless of slot order)."""
    assert len(slots) >= 2, "need at least 2 slots to combine"
    assert all(2 <= k <= len(slots) for k in ks), "each k must be 2..len(slots)"
    arms = [
        ",".join(sorted({tok for slot in combo for tok in slot.split("+") if tok}))
        for k in ks
        for combo in itertools.combinations(slots, k)
    ]
    assert len(arms) == len(set(arms)), "combinations of distinct slots never collide"
    return tuple(arms)


def ensure_config(eval_dir: pathlib.Path, slug: str) -> None:
    """Idempotently write the arm's label config. Content is fixed, tiny, and
    gitignored (evals/**/configs/L-*.yaml) — the driver recreates at will."""
    assert eval_dir.is_dir(), f"eval dir missing: {eval_dir}"
    assert slug and "/" not in slug, "slug must be path-safe"
    path = eval_dir / "configs" / f"L-{slug}.yaml"
    text = (
        f"name: L-{slug}\n"
        "runner: ../run-grim\n"
        "# generated by evals/sweep-langs — label only. The language set is\n"
        "# exported as GRIM_EVAL_LANGUAGES by the driver; each run's actual\n"
        "# set is stamped in its grim-run.json.\n"
    )
    if not path.exists() or path.read_text(encoding="utf-8") != text:
        path.write_text(text, encoding="utf-8")


def smevals_cmd() -> list[str]:
    """`smevals` from PATH when installed, else ephemeral via uvx."""
    found = shutil.which("smevals")
    cmd = [found] if found else ["uvx", "smevals"]
    assert cmd and cmd[0], "resolved a launcher"
    return cmd


def invocation(eval_name: str, arm: str, opts: Options) -> tuple[list[str], dict[str, str]]:
    """(argv, env) for one arm x eval smevals run."""
    assert eval_name in opts.evals, "eval comes from the validated list"
    assert arm in opts.arms, "arm comes from the validated list"
    argv = smevals_cmd() + [
        "run", str(EVALS_DIR / eval_name),
        "-c", f"L-{arm_slug(arm)}", "-m", opts.model, "-g",
    ]
    env = os.environ | arm_env(arm)
    return argv, env


def run_sweep(opts: Options) -> None:
    """All arms x evals, sequentially. A nonzero smevals exit usually just
    means some runs graded fail — expected mid-sweep, never fatal here."""
    assert len(opts.arms) <= MAX_ARMS, "bounded arm count"
    assert len(opts.evals) <= MAX_EVALS, "bounded eval count"
    total = len(opts.arms) * len(opts.evals)
    done = 0
    for arm in opts.arms:
        for eval_name in opts.evals:
            argv, env = invocation(eval_name, arm, opts)
            done += 1
            print(f"\n=== [{done}/{total}] arm={arm} eval={eval_name} ===", flush=True)
            if opts.dry_run:  # print only — a dry run writes nothing, not even configs
                knobs = " ".join(f"{k}='{v}'" for k, v in sorted(arm_env(arm).items()))
                print(f"  {knobs} {' '.join(argv)}" + (f"  (x{opts.n})" if opts.n > 1 else ""))
                continue
            ensure_config(EVALS_DIR / eval_name, arm_slug(arm))
            for _ in range(opts.n):  # bounded: n validated <= N_MAX
                subprocess.run(argv, env=env, check=False)


def _metrics_of(grade: dict[str, Any]) -> dict[str, Any]:
    """The run-metrics check's metrics block, or {} when absent/skipped."""
    assert isinstance(grade, dict), "caller passes a parsed grade.yaml"
    for check in grade.get("checks") or []:
        if str(check.get("checker", "")).endswith(METRICS_CHECKER_SUFFIX):
            metrics = check.get("metrics")
            return metrics if isinstance(metrics, dict) else {}
    return {}


def _run_duration(grade_path: pathlib.Path) -> float:
    """Wall-clock seconds for this Run, from the sibling run.yaml (written by
    smevals for every Run regardless of grading — grade_path.parents[2] is
    the Run's own <ts> directory). 0.0 when missing/unreadable, matching
    collect_rows' tolerance for partial data."""
    run_yaml = grade_path.parents[2] / "run.yaml"
    try:
        data = yaml.safe_load(run_yaml.read_text(encoding="utf-8"))
    except (OSError, yaml.YAMLError):
        return 0.0
    if not isinstance(data, dict):
        return 0.0
    duration = float(data.get("duration_seconds", 0.0) or 0.0)
    assert duration >= 0, "a wall-clock duration is never negative"
    return duration


def collect_rows(evals: tuple[str, ...]) -> list[RunRow]:
    """Every graded L-* run under the given evals, flattened."""
    assert evals, "at least one eval"
    rows: list[RunRow] = []
    for eval_name in evals:
        for grade_path in sorted((EVALS_DIR / eval_name).glob("runs/*/L-*/*/*/grades/default/grade.yaml")):
            try:
                grade = yaml.safe_load(grade_path.read_text(encoding="utf-8"))
            except (OSError, yaml.YAMLError):
                continue
            if not isinstance(grade, dict):
                continue
            # grade_path = runs/<task>/<config>/<model>/<ts>/grades/default/grade.yaml
            # parents:            [4]      [3]     [2]   [1]     [0]
            config_dir = grade_path.parents[4].name
            model_dir = grade_path.parents[3].name
            assert config_dir.startswith("L-"), "glob only matches arm configs"
            rows.append(RunRow(
                arm=config_dir[2:].replace("+", ","),
                model_dir=model_dir,
                eval_name=eval_name,
                passed=grade.get("outcome") == "pass",
                metrics=_metrics_of(grade),
                duration_s=_run_duration(grade_path),
            ))
    return rows


def _fmt_duration(total_s: float) -> str:
    """`125.4` -> `2m05s`; under a minute -> `48s`. Whole seconds only — a
    scan-friendly summary, not a stopwatch."""
    assert total_s >= 0, "duration is never negative"
    total = round(total_s)
    minutes, seconds = divmod(total, 60)
    return f"{minutes}m{seconds:02d}s" if minutes else f"{seconds}s"


def _lean_summary(lean_sums: dict[str, int]) -> str:
    """Top-3 written languages, e.g. `python:5 jq:2` ('-' when none)."""
    assert isinstance(lean_sums, dict), "lean sums is a dict"
    top = sorted(lean_sums.items(), key=lambda kv: (-kv[1], kv[0]))[:3]
    text = " ".join(f"{k.removeprefix('writes_')}:{v}" for k, v in top)
    return text or "-"


def summarize(rows: list[RunRow]) -> list[dict[str, Any]]:
    """Per (arm, model): totals across evals plus a per-eval pass breakdown."""
    assert isinstance(rows, list), "rows is a list"
    groups: dict[tuple[str, str], list[RunRow]] = {}
    for row in rows:
        groups.setdefault((row.arm, row.model_dir), []).append(row)
    out: list[dict[str, Any]] = []
    for (arm, model_dir), members in groups.items():
        n = len(members)
        assert n > 0, "a group always has members"
        cost = sum(float(r.metrics.get("cost_usd", 0.0)) for r in members)
        steps = sum(int(r.metrics.get("steps", 0)) for r in members)
        shell = sum(int(r.metrics.get("runs_shell", 0)) for r in members)
        runs_total = sum(int(r.metrics.get("runs_total", 0)) for r in members)
        lean: dict[str, int] = {}
        by_eval: dict[str, list[bool]] = {}
        for r in members:
            by_eval.setdefault(r.eval_name, []).append(r.passed)
            for key, value in r.metrics.items():
                if key.startswith("writes_"):
                    lean[key] = lean.get(key, 0) + int(value)
        out.append({
            "arm": arm, "model": model_dir, "runs": n,
            "passes": sum(r.passed for r in members),
            "pass_pct": 100.0 * sum(r.passed for r in members) / n,
            "cost_mean": cost / n, "steps_mean": steps / n,
            "escape_pct": (100.0 * shell / runs_total) if runs_total else 0.0,
            "fmt_errors": sum(int(r.metrics.get("format_errors", 0)) for r in members),
            "duration_total_s": sum(r.duration_s for r in members),
            "duration_mean_s": sum(r.duration_s for r in members) / n,
            "lean": _lean_summary(lean),
            "by_eval": " ".join(
                f"{e.removeprefix('grim-')}:{sum(v)}/{len(v)}" for e, v in sorted(by_eval.items())
            ),
        })
    out.sort(key=lambda a: (-a["pass_pct"], a["cost_mean"]))
    return out


def render(aggregates: list[dict[str, Any]]) -> str:
    """The arm comparison table, best arm first."""
    assert isinstance(aggregates, list), "aggregates is a list"
    if not aggregates:
        return "no graded L-* runs found — run a sweep first (or check --evals)"
    head = (f"{'arm':38} {'model':28} {'pass':>9} {'cost$':>7} {'steps':>6} "
            f"{'esc%':>5} {'fmtE':>4} {'wall':>8}  {'lean(writes)':18} per-eval")
    lines = [head, "-" * len(head)]
    for a in aggregates:
        lines.append(
            f"{a['arm']:38} {a['model']:28} {a['passes']:>3}/{a['runs']:<3}{a['pass_pct']:>4.0f}% "
            f"{a['cost_mean']:>7.4f} {a['steps_mean']:>6.1f} {a['escape_pct']:>5.1f} "
            f"{a['fmt_errors']:>4} {_fmt_duration(a['duration_total_s']):>8}  {a['lean']:18} {a['by_eval']}"
        )
    return "\n".join(lines)


def parse_args(argv: list[str] | None) -> Options:
    """CLI boundary: untrusted input becomes validated Options here, once."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--arms", action="append", default=[], help="comma-joined set; repeatable")
    parser.add_argument(
        "--preset",
        choices=["screen", "overnight"],
        help="screen: 10 arms; overnight: 26 arms — controls + each language solo and +bash + pool",
    )
    parser.add_argument(
        "--combo", action="append", default=[],
        help="one slot (may be a +joined atomic unit, e.g. tcl+expect); repeatable, needs --combo-k",
    )
    parser.add_argument(
        "--combo-k", default="",
        help="comma-joined arity sizes to generate from --combo slots, e.g. 2 or 2,3",
    )
    parser.add_argument("--evals", default=",".join(SCREEN_EVALS))
    parser.add_argument("-m", "--model", default=DEFAULT_MODEL)
    parser.add_argument("-n", type=int, default=1, help="repetitions per arm x eval (1..%d)" % N_MAX)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--report-only", action="store_true")
    args = parser.parse_args(argv)
    presets = {"screen": SCREEN_ARMS, "overnight": OVERNIGHT_ARMS}
    for slot in args.combo:
        if not _ARM_RE.match(slot.replace("+", ",")):
            parser.error(f"malformed --combo slot: {slot!r}")
    try:
        combo_ks = tuple(int(k) for k in args.combo_k.split(",") if k.strip())
    except ValueError:
        parser.error(f"--combo-k must be comma-joined integers, got {args.combo_k!r}")
    if args.combo and not combo_ks:
        parser.error("--combo needs --combo-k (e.g. --combo-k 2)")
    if combo_ks and len(args.combo) < 2:
        parser.error("--combo needs at least 2 slots")
    if combo_ks and not all(2 <= k <= len(args.combo) for k in combo_ks):
        parser.error(f"--combo-k values must be 2..{len(args.combo)}")
    generated = combo_arms(tuple(args.combo), combo_ks) if combo_ks else ()
    arms = tuple(args.arms) + presets.get(args.preset or "", ()) + generated
    evals = tuple(e.strip() for e in args.evals.split(",") if e.strip())
    if not args.report_only and not arms:
        parser.error("no arms: pass --arms a,b (repeatable), --preset screen, or --combo/--combo-k")
    if not (0 < len(evals) <= MAX_EVALS) or (arms and len(arms) > MAX_ARMS):
        parser.error(f"bounds: 1..{MAX_EVALS} evals, <= {MAX_ARMS} arms")
    if not (1 <= args.n <= N_MAX):
        parser.error(f"-n must be 1..{N_MAX}")
    for eval_name in evals:
        if not (EVALS_DIR / eval_name / "eval.yaml").is_file():
            parser.error(f"not an eval: {eval_name}")
    for arm in arms:
        if not _ARM_RE.match(arm):
            parser.error(f"malformed arm: {arm!r}")
    return Options(arms, evals, args.model, args.n, args.dry_run, args.report_only)


def main(argv: list[str] | None = None) -> int:
    opts = parse_args(argv)
    if not opts.report_only:
        run_sweep(opts)
    if not opts.dry_run:
        print("\n" + render(summarize(collect_rows(opts.evals))))
    return 0


if __name__ == "__main__":
    sys.exit(main())
