#!/usr/bin/env bash
# smevals Runner for grim-agent PROBLEM-SOLVING tasks (ARC-AGI picks). Same
# contract as grim-smoke/run-grim (inputs via env, final answer on stdout,
# non-zero exit reserved for infra faults); like grim-debug, every task
# declares `files: <dir>` and the runner materializes tasks/files/<dir> into
# $SMEVALS_RUN_DIR/workspace and launches the agent there — task.json holds
# the puzzle WITHOUT the answer (the expected grid lives only in the task
# yaml, which the agent never sees).
# Ref: https://github.com/prime-radiant-inc/smevals  (`smevals docs`)
#
# GRIM_DB is ALWAYS set explicitly so an eval never touches ~/.grimoire:
#   1. SMEVALS_TASK_GRIM_DB  per-task path   → grouped tasks
#   2. GRIM_EVAL_DB          operator export → WARM shared library
#   3. (neither set)         COLD: fresh DB under the Run dir
set -uo pipefail

: "${SMEVALS_MODEL:?run-grim: SMEVALS_MODEL is required}"
: "${SMEVALS_PROMPT:?run-grim: SMEVALS_PROMPT is required (the task needs a prompt)}"
: "${SMEVALS_RUN_DIR:?run-grim: SMEVALS_RUN_DIR is required}"
: "${SMEVALS_TASK_FILES:?run-grim: task must declare files: <dir> (under tasks/files/)}"

# BASH_SOURCE locates this eval dir regardless of smevals' working directory.
# Ref: https://www.gnu.org/software/bash/manual/bash.html#index-BASH_005fSOURCE
EVAL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FILES_DIR="$EVAL_DIR/tasks/files/$SMEVALS_TASK_FILES"
if [ ! -d "$FILES_DIR" ]; then
  echo "run-grim: $FILES_DIR does not exist — infra failure" >&2
  exit 1
fi

WORKSPACE="$SMEVALS_RUN_DIR/workspace"
mkdir -p "$WORKSPACE"
cp -R "$FILES_DIR/." "$WORKSPACE/"
cd "$WORKSPACE" || exit 1

export GRIM_DB="${SMEVALS_TASK_GRIM_DB:-${GRIM_EVAL_DB:-$SMEVALS_RUN_DIR/grimoire.db}}"
export GRIM_TRAJ_DIR="$SMEVALS_RUN_DIR"   # keep the trajectory JSON as a Run artifact

# Breadcrumbs go to stderr (captured as stderr.txt, tail -f-able) — stdout is
# EXCLUSIVELY the answer channel: it becomes output.txt, which the Grader reads.
if [ -n "${SMEVALS_TASK_GRIM_DB:-}" ]; then DB_MODE="grouped"
elif [ -n "${GRIM_EVAL_DB:-}" ]; then DB_MODE="warm"
else DB_MODE="cold"; fi
echo "run-grim: task=$SMEVALS_TASK model=$SMEVALS_MODEL db=$DB_MODE ($GRIM_DB) workspace=$WORKSPACE" >&2

# `-p` (print mode) is load-bearing: only the final answer reaches stdout and
# the run never blocks on interactive follow-ups. See grim-smoke/run-grim.
# shellcheck disable=SC2086
out="$(${GRIM_AGENT_CMD:-grim-agent} -p -m "$SMEVALS_MODEL" -t "$SMEVALS_PROMPT")"
ec=$?
echo "run-grim: agent done exit=$ec answer_chars=${#out}" >&2

printf '%s\n' "$out"

if [ "$ec" -eq 2 ] || [ -z "${out//[[:space:]]/}" ]; then
  echo "run-grim: grim-agent produced no answer (exit $ec) — infra failure" >&2
  exit 1
fi
exit 0
